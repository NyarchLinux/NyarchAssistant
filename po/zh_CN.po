#: src/handlers/interfaces/chat_interface.py:339
#, python-brace-format
msgid ""
"👋 Welcome to Newelle! Your chat: \"{chat_name}\" (ID: {chat_id})\n"
"\n"
"📋 Commands:\n"
"🆕 /new - Create a new chat\n"
"⏹️ /stop - Stop the response being generated\n"
"/compact - Summarize the conversation to reduce context size\n"
"/workspaces - List workspaces\n"
"/workspace <name or ID> - Switch workspace globally\n"
"/workspace new <name> - Create a workspace\n"
"/workspace rename|profile|path <value> - Edit current workspace\n"
"/workspace delete <name or ID> - Move chats to Default and delete\n"
"/move_workspace <chat_id> <workspace> - Move a chat and branches\n"
"🤖 /models - List available models\n"
"🔀 /model [provider:]model - Switch model\n"
"👤 /profile <name> - Switch profile\n"
"🎨 /mode [name] - View/switch modes\n"
"📝 /prompts - View prompts\n"
"🔧 /tools - View/toggle tools\n"
"⏰ /scheduled - View scheduled tasks\n"
"⚡ /skill <name> - Execute a skill command\n"
"📂 /cd [path] - Change working directory\n"
"📋 /list_chats - List all chats\n"
"👀 /peek <chat_id> - Preview messages from a chat\n"
"🔄 /resume <chat_id> - Switch to a different chat\n"
"⚡ /autoexec - Enable/disable auto command execution\n"
"🔢 /option <n> - Choose an option when prompted\n"
msgstr ""
"👋 欢迎来到 Newelle！你的对话：\"{chat_name}\"（ID：{chat_id}）\n"
"\n"
"📋 命令：\n"
"🆕 /new - 新建对话\n"
"⏹️ /stop - 停止正在生成的回复\n"
"/compact - 总结对话以缩减上下文大小\n"
"/workspaces - 列出工作区\n"
"/workspace <name or ID> - 全局切换工作区\n"
"/workspace new <name> - 创建工作区\n"
"/workspace rename|profile|path <value> - 编辑当前工作区\n"
"/workspace delete <name or ID> - 将对话移至 Default 并删除该工作区\n"
"/move_workspace <chat_id> <workspace> - 移动对话及其分支\n"
"🤖 /models - 列出可用模型\n"
"🔀 /model [provider:]model - 切换模型\n"
"👤 /profile <name> - 切换配置方案\n"
"🎨 /mode [name] - 查看/切换模式\n"
"📝 /prompts - 查看提示词\n"
"🔧 /tools - 查看/开关工具\n"
"⏰ /scheduled - 查看定时任务\n"
"⚡ /skill <name> - 执行技能命令\n"
"📂 /cd [path] - 更改工作目录\n"
"📋 /list_chats - 列出全部对话\n"
"👀 /peek <chat_id> - 预览某个对话的消息\n"
"🔄 /resume <chat_id> - 切换到其他对话\n"
"⚡ /autoexec - 开启/关闭命令自动执行\n"
"🔢 /option <n> - 在出现选项时进行选择\n"

