[Desktop Entry]
Name=Nyarch Assistant
Comment=Advanced AI waifu to help you
Exec=nyarchassistant
Icon=moe.nyarchlinux.assistant
Terminal=false
Type=Application
Categories=Utility;
StartupNotify=true
Keywords=ai;assistant;chat;chatgpt;gpt;llm;ollama;
Actions=mini-window;

[Desktop Action mini-window]
Name=Mini Window
Exec=newelle --mini
Icon=io.github.qwersyk.Newelle
