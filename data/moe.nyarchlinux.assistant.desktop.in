[Desktop Entry]
Name=Nyarch Assistant
Comment=Advanced AI waifu to help you
Exec=nyarchassistant
Icon=moe.nyarchlinux.assistant
Terminal=false
Type=Application
Categories=Utility;
StartupNotify=true
Keywords=ai;assistant;chat;chatgpt;gpt;llm;ollama;
Actions=mini-window;voice-mode;

[Desktop Action mini-window]
Name=Mini Window
Exec=nyarchassistant --mini
Icon=moe.nyarchlinux.assistant

[Desktop Action voice-mode]
Name=Voice Mode
Exec=nyarchassistant --voice
Icon=moe.nyarchlinux.assistant
